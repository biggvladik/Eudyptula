From 09eab4c20cdd9e710f18efeccdc5928e302b1b94 Mon Sep 17 00:00:00 2001
From: biggvladik <zuevvlad55@gmail.com>
Date: Tue, 4 Aug 2026 01:10:19 +0300
Subject: [PATCH] input: pcspkr: add id device attribute

Add a read-write device attribute that exposes the assigned Eudyptula
ID. Accept writes only when the supplied value matches the ID.

Attach the attribute only to devices bound to the pcspkr driver

Signed-off-by: biggvladik <zuevvlad55@gmail.com>
---
 drivers/input/misc/pcspkr.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/drivers/input/misc/pcspkr.c b/drivers/input/misc/pcspkr.c
index 0467808402f2..8609ecfde1ca 100644
--- a/drivers/input/misc/pcspkr.c
+++ b/drivers/input/misc/pcspkr.c
@@ -14,6 +14,7 @@
 #include <linux/platform_device.h>
 #include <linux/timex.h>
 #include <linux/io.h>
+#include <linux/sysfs.h>
 
 MODULE_AUTHOR("Vojtech Pavlik <vojtech@ucw.cz>");
 MODULE_DESCRIPTION("PC Speaker beeper driver");
@@ -121,10 +122,38 @@ static const struct dev_pm_ops pcspkr_pm_ops = {
 	.suspend = pcspkr_suspend,
 };
 
+#define EUDYPTULA_ID "biggvladik"
+
+static ssize_t id_show(struct device *dev,
+		       struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%s\n", EUDYPTULA_ID);
+}
+
+static ssize_t id_store(struct device *dev,
+			struct device_attribute *attr,
+			const char *buf, size_t count)
+{
+	if (!sysfs_streq(buf, EUDYPTULA_ID))
+		return -EINVAL;
+
+	return count;
+}
+
+static DEVICE_ATTR_RW(id);
+
+static struct attribute *pcspkr_attrs[] = {
+	&dev_attr_id.attr,
+	NULL,
+};
+
+ATTRIBUTE_GROUPS(pcspkr);
+
 static struct platform_driver pcspkr_platform_driver = {
 	.driver		= {
 		.name	= "pcspkr",
 		.pm	= &pcspkr_pm_ops,
+		.dev_groups = pcspkr_groups,
 	},
 	.probe		= pcspkr_probe,
 	.remove		= pcspkr_remove,
-- 
